{
  "name": "alltoolapp",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "ToolHaven Studio: one polished web app with every PDF, image and calculator tool. Files never leave your device.",
  "scripts": {
    "dev": "node scripts/copy-pdfjs-assets.mjs && vite",
    "prebuild": "node scripts/copy-pdfjs-assets.mjs",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "node tests/e2e/run.mjs",
    "ci": "npm run test && npm run build && npm run test:e2e"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "jszip": "^3.10.2",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^4.10.38"
  },
  "devDependencies": {
    "axe-core": "^4.14.1",
    "playwright-core": "^1.65.1",
    "typescript": "~5.9.0",
    "vite": "^7.0.0",
    "vitest": "^3.2.0"
  },
  "engines": {
    "node": ">=20"
  }
}
