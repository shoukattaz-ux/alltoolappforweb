{
  "name": "alltoolapp",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "ToolHaven Studio: one polished web app with every PDF, image and calculator tool. Files never leave your device.",
  "scripts": {
    "dev": "node scripts/copy-pdfjs-assets.mjs && vite",
    "prebuild": "node scripts/copy-pdfjs-assets.mjs",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "og": "node scripts/make-og-image.mjs",
    "android:assets": "node scripts/make-android-assets.mjs",
    "android:sync": "npm run build && cap sync android",
    "android:open": "cap open android",
    "android:debug": "npm run android:sync && cd android && ./gradlew assembleDebug",
    "test": "vitest run",
    "test:e2e": "node tests/e2e/run.mjs",
    "ci": "npm run test && npm run build && npm run test:e2e",
    "site": "node scripts/make-site.mjs",
    "store:assets": "node scripts/make-store-assets.mjs",
    "android:release": "npm run android:sync && cd android && ./gradlew bundleRelease assembleRelease"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.2",
    "@capacitor/core": "^8.6.2",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/share": "^8.0.3",
    "@fontsource-variable/inter": "^5.3.0",
    "jszip": "^3.10.2",
    "mediabunny": "^1.66.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^4.10.38"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.2",
    "@types/node": "^22.20.5",
    "axe-core": "^4.14.1",
    "playwright-core": "^1.65.1",
    "typescript": "~5.9.0",
    "vite": "^7.0.0",
    "vitest": "^3.2.0"
  },
  "engines": {
    "node": ">=20"
  }
}
